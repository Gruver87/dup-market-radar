# KuCoin API (spot trading). Copy to .env — never commit .env.
# Create key with Spot Trade permission only; prefer IP whitelist.
# Secrets are scrubbed from process logs + audit JSONL (see radar.secrets_redact).
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSPHRASE=
# Optional override (HTTPS allowlist only: api.kucoin.com / openapi-v2.kucoin.com):
# KUCOIN_API_BASE=https://api.kucoin.com

# Optional Radar API gate for trade mutations (POST /api/trade/*).
# When set, clients must send header: X-Radar-Api-Key: <value>
# Dashboard: localStorage.setItem("radar_api_key", "<value>")
# RADAR_API_KEY=
# Fail-closed: refuse trade mutations if key unset (docker compose defaults to 1).
# RADAR_REQUIRE_API_KEY=1
# Behind a trusted reverse proxy only — use X-Forwarded-For for rate-limit keys:
# RADAR_TRUST_PROXY=0
# Lab only — expose FastAPI /docs + /openapi.json (off by default):
# RADAR_ENABLE_OPENAPI=1
# HTTPS edge only — Strict-Transport-Security max-age seconds (omit on plain HTTP):
# RADAR_HSTS_MAX_AGE=31536000

# Telegram bot (optional). BotFather token + allow-listed chat id(s).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=123456789
# Or multiple: TELEGRAM_ALLOWED_CHAT_IDS=123,456
# TELEGRAM_ENABLED=1

# Container overrides (docker compose):
# RADAR_NATIVE_PREFER=0
# RADAR_NATIVE_FAIL_CLOSED=0

# Snapshot auth (optional):
# RADAR_SNAPSHOT_REQUIRE_API_KEY=1
